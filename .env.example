# ───────────────────────── Shared infra ─────────────────────────
# Postgres is shared by the web app (Prisma) and the API (SQLAlchemy).
DATABASE_URL=postgresql://shighlight:shighlight@localhost:5432/streamhighlighter
REDIS_URL=redis://localhost:6379/0

# Object storage for media in/out (S3-compatible: AWS S3, Cloudflare R2, MinIO)
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=streamhighlighter-media
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# ───────────────────────── Web (Next.js) ─────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-with-openssl-rand-base64-32
# Internal URL the web app uses to reach the FastAPI service
API_BASE_URL=http://localhost:8000
# Shared secret signing requests between web <-> api
INTERNAL_API_SECRET=change-me

# OAuth providers (sign-in)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# ───────────────────────── Billing (Stripe) ─────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=price_xxx
STRIPE_PRICE_PRO=price_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ───────────────────────── AI / pipeline (API) ─────────────────────────
ANTHROPIC_API_KEY=
# Whisper: "local" (faster-whisper) or "openai"
TRANSCRIBE_BACKEND=local
OPENAI_API_KEY=
# faster-whisper (local backend) — install with: pip install -e ".[transcribe]"
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Source platform APIs (VOD retrieval + publishing)
TWITCH_API_CLIENT_ID=
TWITCH_API_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
